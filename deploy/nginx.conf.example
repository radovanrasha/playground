# /etc/nginx/sites-available/playground  →  symlink into sites-enabled/
#
# The frontend container is published on 127.0.0.1:3006 (docker-compose.yml).
# nginx terminates the domain + TLS and reverse-proxies to that port.
#
#   1) Put this file at /etc/nginx/sites-available/playground
#   2) ln -s /etc/nginx/sites-available/playground /etc/nginx/sites-enabled/
#   3) nginx -t && systemctl reload nginx
#   4) certbot --nginx -d playground.radovanrasha.com
#      (certbot rewrites this file to add the TLS/443 block automatically)

server {
    listen 80;
    listen [::]:80;

    server_name playground.radovanrasha.com;

    location / {
        # 3006 = the HOST_PORT published in docker-compose.yml.
        proxy_pass http://127.0.0.1:3006;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
